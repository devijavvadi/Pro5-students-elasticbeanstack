# ==========================================
# 1. Terraform & Infrastructure Security
# ==========================================
# NEVER commit your secrets file containing "Geethanshi1234"
terraform/terraform.tfvars
terraform/terraform.tfvars.json

# Ignore local terraform runtime files and cache
terraform/.terraform/
terraform/.terraform.lock.hcl

# Ignore terraform state files (these contain infrastructure secrets)
terraform/*.tfstate
terraform/*.tfstate.backup

# ==========================================
# 2. PHP & OS Local System Files
# ==========================================
# Ignore local deployment zip archives
*.zip

# Ignore environment variables if created locally
.env
.env.local

# Operating System files
.DS_Store
Thumbs.db

# ==========================================
# 3. Java Artifact Cleanup (Not needed for PHP)
# ==========================================
# Exclude Java compile target outputs completely
target/
build/
.gradle/
*.jar
*.war
