# ==============================================================================
# 1. Terraform Cloud State & Binary Exclusions
# ==============================================================================
# Excludes heavy engine binary packages (such as the 685MB AWS provider .exe)
terraform/.terraform/
terraform/.terraform.lock.hcl

# Excludes local configuration environment and variable credentials
*terraform/terraform.tfvars
terraform/terraform.tfvars.json

# Excludes direct backend state blueprints (hides running infrastructure metrics)
terraform/*.tfstate
terraform/*.tfstate.backup

# ==============================================================================
# 2. PHP Application Bundles & Framework Cache
# ==============================================================================
# Excludes local build delivery compression zip files from entering git history
*.zip

# Excludes local software configuration deployment environment parameters
.env
.env.local

# Operating System background tracking logs
.DS_Store
Thumbs.db
desktop.ini

# ==============================================================================
# 3. Code Optimization Filters (Clears out leftover artifacts)
# ==============================================================================
# Excludes Java framework target artifacts (keeps your PHP codebase light)
target/
build/
.gradle/
*.jar
*.war
